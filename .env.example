# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env

# Koneksi PostgreSQL (dipakai aplikasi, drizzle-kit, dan seeder).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siaga_cctv

# Kunci rahasia untuk menandatangani session NextAuth (Auth.js v5).
# Wajib diganti. Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Isi true jika aplikasi dijalankan di belakang reverse proxy (nginx, dll.)
# atau di host selain localhost.
# AUTH_TRUST_HOST=true

# URL publik aplikasi. Opsional, umumnya hanya perlu di produksi
# jika deteksi host otomatis tidak tepat.
# AUTH_URL=http://localhost:3000
